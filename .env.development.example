# ============================================================================
#  Maliyetik — geliştirme ortamı (örnek)
#  scripts/ortam.sh bu dosyayla ayrı bir Compose projesi (maliyetik-dev) kaldırır;
#  üretim yığınıyla aynı makinede yan yana çalışabilir.
#  Kullanım:  cp .env.development.example .env.development
# ============================================================================

TZ=Europe/Istanbul
APP_URL=http://localhost:3341
FRONTEND_BIND=127.0.0.1
FRONTEND_HOST_PORT=3341
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=
VITE_SUPPORT_EMAIL=
CORS_ORIGINS=http://localhost:3341
# development: SQL sorgu günlüğü açılır
NODE_ENV=development

DB_ROOT_PASSWORD=change-me-dev-root-password
DB_DATABASE=maliyetik_dev
DB_USERNAME=maliyetik_dev
DB_PASSWORD=change-me-dev-db-password
MYSQL_BUFFER_POOL=256M
MYSQL_MAX_CONNECTIONS=100

REDIS_PASSWORD=change-me-dev-redis-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me-dev-smtp-user
SMTP_PASS=change-me-dev-smtp-password
SMTP_FROM=Maliyetik Dev <no-reply@dev.example.com>

JWT_ACCESS_SECRET=change-me-dev-access-secret-64-hex
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-64-hex
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Üretimden farklı bir kova kullanın; aksi halde test evrakları gerçek veriye karışır.
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-dev-bucket-name
GCS_CREDENTIALS_B64=

MAX_UPLOAD_MB=50

GEMINI_API_KEY=
GEMINI_MODEL_LIGHT=gemini-2.5-flash

ADMIN_EMAIL=admin@dev.example.com
ADMIN_PASSWORD=change-me-dev-admin-password

PAYMENT_PROVIDER=mock
ENFORCE_SEAT_LIMITS=false
