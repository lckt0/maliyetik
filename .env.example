# ============================================================================
#  Maliyetik — ortam değişkenleri (örnek)
#  Kullanım:  cp .env.example .env  ve değerleri doldurun. .env depoya girmez.
#  Gizli değerleri üretmek için:  openssl rand -hex 32
# ============================================================================

# ---- Genel ----
TZ=Europe/Istanbul
# Uygulamanın dışarıdan görünen adresi (e-posta bağlantıları, dosya adresleri).
APP_URL=http://localhost:3340
# Frontend'in host'ta dinleyeceği adres ve port.
FRONTEND_BIND=127.0.0.1
FRONTEND_HOST_PORT=3340
# Frontend nginx /api isteklerini backend'e iletir; bu yüzden göreli bırakın.
VITE_API_BASE_URL=/api/v1
# Canonical/og etiketleri ve site haritası için (boşsa APP_URL kullanılır).
VITE_SITE_URL=
# Abonelik sayfasındaki destek adresi (boşsa destek@<alan-adı>).
VITE_SUPPORT_EMAIL=
# Virgülle ayrılmış izinli origin listesi (CORS).
CORS_ORIGINS=http://localhost:3340

# ---- MySQL ----
DB_ROOT_PASSWORD=change-me-root-password
DB_DATABASE=maliyetik
DB_USERNAME=maliyetik
DB_PASSWORD=change-me-db-password
MYSQL_BUFFER_POOL=1G
MYSQL_MAX_CONNECTIONS=300

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password

# ---- SMTP (e-posta doğrulama, şifre sıfırlama) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me-smtp-user
SMTP_PASS=change-me-smtp-password
SMTP_FROM=Maliyetik <no-reply@example.com>

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change-me-access-secret-64-hex
JWT_REFRESH_SECRET=change-me-refresh-secret-64-hex
JWT_ACCESS_TTL=900          # 15 dk (saniye)
JWT_REFRESH_TTL=1209600     # 14 gün (saniye)

# ---- Google Cloud Storage (evrak dosyaları) ----
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-bucket-name
# Servis hesabı JSON dosyasının base64'ü:  base64 -w0 service-account.json
GCS_CREDENTIALS_B64=

# ---- Yükleme ----
MAX_UPLOAD_MB=50

# ---- Gemini (isteğe bağlı: evrak dijitalleştirme ve yapay zeka özellikleri) ----
# Boş bırakılırsa bu özellikler kapalı kalır. Anahtar yalnızca sunucuda kullanılır.
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-flash-latest
GEMINI_MODEL_LIGHT=gemini-2.5-flash
GEMINI_MODEL_ADVANCED=gemini-pro-latest
GEMINI_CONFIDENCE_THRESHOLD=0.85

# ---- İlk admin (backend seeder oluşturur: npm run seed:prod) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- Ödeme (isteğe bağlı) ----
# 'mock' (varsayılan; gerçek para hareketi yok, ödeme akışı kullanıcıya kapalı),
# 'iyzico' veya 'shopier'.
PAYMENT_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
SHOPIER_WEBSITE_INDEX=1
# Mali müşavir paketlerindeki mükellef koltuğu sınırı uygulansın mı.
ENFORCE_SEAT_LIMITS=false

# ---- Admin > Altyapı Maliyetleri canlı verisi (isteğe bağlı) ----
# Hiçbiri verilmezse sayfa yalnızca elle girilen maliyetlerle çalışır.
# GCP faturalandırma verisi BigQuery dışa aktarım tablosundan okunur.
GCP_BILLING_CREDENTIALS_B64=
GCP_BILLING_BQ_DATASET=
GCP_BILLING_BQ_TABLE=
BREVO_API_KEY=
